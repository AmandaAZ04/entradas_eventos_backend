# Configuración privada en /etc/entradas_eventos/entradas.env (nunca en Git).
# Valores entre comillas simples son compatibles con systemd y python-dotenv.
DJANGO_SECRET_KEY='REEMPLAZAR_CON_CLAVE_ALEATORIA'
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS='TU_IP_O_DOMINIO,127.0.0.1,localhost'
DJANGO_CSRF_TRUSTED_ORIGINS='http://TU_IP_O_DOMINIO'
DJANGO_STATIC_ROOT=/var/www/entradas_eventos/static
DB_NAME=entradas_eventos_db
DB_USER=entradas_app
DB_PASSWORD='REEMPLAZAR_CON_PASSWORD_DE_POSTGRESQL'
DB_HOST=127.0.0.1
DB_PORT=5432
WEBPAY_ENVIRONMENT=integration
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_RETURN_URL='http://TU_IP_O_DOMINIO/pago/retorno/'
# Después de instalar y verificar el certificado HTTPS, cambiar los tres a True.
DJANGO_BEHIND_HTTPS_PROXY=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
